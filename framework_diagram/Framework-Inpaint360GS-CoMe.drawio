        <mxCell id="uLJMSDSIyRcaIBm-5eIb-207" parent="uLJMSDSIyRcaIBm-5eIb-94" style="rounded=1;whiteSpace=wrap;html=1;horizontal=0;arcSize=18;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;strokeColor=#b85450;strokeWidth=2.5;rotation=90;fillColor=#F8CECC;" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;text-align: left; color: rgb(255, 9, 9);&quot;&gt;Colour confidence&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt; (CoMe, it ≥ 500): L&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;rgb&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt; = ĉ·L&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;pp&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt; − β·log ĉ,&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;Note:&lt;/b&gt; β = 0.075, ĉ ∈ [1e-3, 5] — unexplainable pixels (view-dependent, transient) get low ĉ instead of floaters&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="450" width="81.4" x="2399.3" y="6.3" as="geometry" />
        </mxCell>
        <mxCell id="uLJMSDSIyRcaIBm-5eIb-215" edge="1" parent="uLJMSDSIyRcaIBm-5eIb-94" source="uLJMSDSIyRcaIBm-5eIb-213" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="uLJMSDSIyRcaIBm-5eIb-212">
          <mxGeometry relative="1" x="-0.1123" as="geometry">
