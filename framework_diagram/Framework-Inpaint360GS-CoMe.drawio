        <mxCell id="uLJMSDSIyRcaIBm-5eIb-212" parent="uLJMSDSIyRcaIBm-5eIb-94" style="rounded=1;whiteSpace=wrap;html=1;horizontal=0;arcSize=18;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;strokeColor=#b85450;strokeWidth=2.5;rotation=90;gradientColor=none;fillColor=#F8CECC;" value="&lt;b style=&quot;text-align: left;&quot;&gt;&lt;font face=&quot;Georgia&quot; style=&quot;font-size: 12px;&quot;&gt;L = L&lt;sub style=&quot;&quot;&gt;rgb&lt;/sub&gt; + λ&lt;sub style=&quot;&quot;&gt;dn&lt;/sub&gt;L&lt;sub style=&quot;&quot;&gt;dn&lt;/sub&gt; + λ&lt;sub style=&quot;&quot;&gt;dist&lt;/sub&gt;L&lt;sub style=&quot;&quot;&gt;dist&lt;/sub&gt; + λ&lt;sub style=&quot;&quot;&gt;sm&lt;/sub&gt;L&lt;sub style=&quot;&quot;&gt;sm&lt;/sub&gt; + λ&lt;sub style=&quot;&quot;&gt;op&lt;/sub&gt;L&lt;sub style=&quot;&quot;&gt;op&lt;/sub&gt; + λ&lt;sub style=&quot;&quot;&gt;ext&lt;/sub&gt;L&lt;sub style=&quot;&quot;&gt;ext&lt;/sub&gt; + λ&lt;sub style=&quot;&quot;&gt;var&lt;/sub&gt;L&lt;sub style=&quot;&quot;&gt;var&lt;/sub&gt; + λ&lt;sub style=&quot;&quot;&gt;nvar&lt;/sub&gt;L&lt;sub style=&quot;&quot;&gt;nvar&lt;/sub&gt;&lt;/font&gt;&lt;/b&gt;" vertex="1">
