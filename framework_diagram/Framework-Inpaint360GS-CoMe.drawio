        <mxCell id="uLJMSDSIyRcaIBm-5eIb-208" parent="uLJMSDSIyRcaIBm-5eIb-94" style="rounded=1;whiteSpace=wrap;html=1;horizontal=0;arcSize=18;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;strokeColor=#b85450;strokeWidth=2.5;rotation=90;fillColor=#F8CECC;" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;text-align: left; color: rgb(255, 3, 3);&quot;&gt;Geometry&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;color: rgb(255, 9, 9);&quot;&gt; &lt;/span&gt;(it ≥ 15k): L&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;dn&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt; = 1 − N·N&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;depth&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt; (λ 0.05) · L&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;dist&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt; depth distortion (λ 100) · L&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;sm&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt; = |∇N|·e&lt;/span&gt;&lt;sup style=&quot;text-align: left;&quot;&gt;−|∇I&lt;sub&gt;gt&lt;/sub&gt;|&lt;/sup&gt;&lt;span style=&quot;text-align: left;&quot;&gt; (λ 0.01) · L&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;op&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt; = (α − 0.5)² (λ 0.004) · L&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;ext&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt; Gaussian extent (λ 0.1) · L&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;var&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt; colour variance along the ray (λ 0.5) · L&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;nvar&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt; normal variance (λ 0.005)&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="450" width="90" x="2395" y="114.3" as="geometry" />
        </mxCell>
        <mxCell id="uLJMSDSIyRcaIBm-5eIb-211" parent="uLJMSDSIyRcaIBm-5eIb-94" style="rounded=1;whiteSpace=wrap;html=1;horizontal=0;arcSize=18;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;strokeColor=#b85450;strokeWidth=2.5;rotation=90;fillColor=#F8CECC;" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;text-align: left; color: rgb(255, 9, 9);&quot;&gt;Photometric&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;color: rgb(255, 9, 9);&quot;&gt; &lt;/span&gt;(it ≥ 0): L&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;pp&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt; = 0.8·L1(A(I), I&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;gt&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt;) + 0.2·(1 − SSIM&lt;/span&gt;&lt;sub style=&quot;text-align: left;&quot;&gt;decoupled&lt;/sub&gt;&lt;span style=&quot;text-align: left;&quot;&gt;) per pixel&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;text-align: left; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 13px;&quot;&gt;Note: A = SSIM-decoupled appearance embedding (64-d code / view + CNN on the 1/32 image → colour gain)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
